# Local development. Copy to .env; then export the values (the app does not load .env itself).
APP_ENV=development
APP_TIMEZONE=Europe/Moscow
APP_URL=http://127.0.0.1:8000
SECURE_COOKIES=false
DATABASE_PATH=server/data/agentpay.sqlite3
PORT=8000

# Optional SMTP. Leave blank to disable actual email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TENANT_ID=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Optional Yandex AI Studio: generic phrasing only, no invoice/contact data.
# Leave both blank for deterministic templates. Use a full gpt://folder/... model URI.
YANDEX_API_KEY=
YANDEX_MODEL=

# Production: APP_ENV=production, APP_URL=https://your-real-domain,
# SECURE_COOKIES=true, DATABASE_PATH=/var/data/agentpay.db on a persistent disk.
# Never put real secrets into Git, Docker build args, frontend variables, or CI logs.
