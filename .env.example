# Local development. Copy once to .env, then run: python -m scripts.run_local
# Direct app imports/tests never read .env. Hosting environment variables take precedence.
APP_ENV=development
APP_TIMEZONE=Europe/Moscow
APP_URL=http://127.0.0.1:8000
SECURE_COOKIES=false
DATABASE_PATH=server/data/agentpay.sqlite3
# Optional: durable hosted PostgreSQL. Takes precedence over DATABASE_PATH.
DATABASE_URL=
PORT=8000

# Optional SMTP. Leave blank to disable actual email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TENANT_ID=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Yandex AI Studio: generic letter phrasing and structured incoming-text analysis.
# Agent requests include the submitted message. Ledger/contact dumps are never sent.
# Leave blank for manual processing. Use a full model URI, e.g.
# YANDEX_MODEL=gpt://<folder-id>/yandexgpt-5.1
# An API key ID is NOT the folder ID and is not used in generation requests.
YANDEX_API_KEY=
YANDEX_MODEL=
YANDEX_AGENT_MODEL=
# Public production requires pilot organization UUIDs from GET /api/agent/status.
# Empty in production disables paid calls; empty in local development permits them.
YANDEX_AGENT_TENANT_IDS=
# Optional actual tariff, RUB/1000 input/output tokens. Blank means unknown cost.
YANDEX_AGENT_INPUT_RUB_PER_1K=
YANDEX_AGENT_OUTPUT_RUB_PER_1K=

# Real Langfuse SDK. Local self-host: python -m scripts.langfuse_local init; see docs/agent-runtime.md.
# Remote hosting requires a reachable endpoint and its project keys.
LANGFUSE_BASE_URL=http://127.0.0.1:3033
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGSMITH_TRACING=false

# Production VM: APP_ENV=production, APP_URL=https://<public-ip>,
# SECURE_COOKIES=true, DATABASE_URL to the private persistent PostgreSQL service.
# See compose.production.yml and infra/yandex/README.md. Langfuse is optional.
# Never put real secrets into Git, Docker build args, frontend variables, or CI logs.
