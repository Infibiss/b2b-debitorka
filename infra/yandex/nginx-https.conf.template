server {
    listen 80 default_server;
    server_name PUBLIC_IP;
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 308 https://PUBLIC_IP$request_uri; }
}
server {
    listen 443 ssl default_server;
    server_name PUBLIC_IP;
    ssl_certificate /etc/letsencrypt/live/agentpay-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agentpay-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:1m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    resolver 127.0.0.11 valid=30s ipv6=off;
    location / {
        set $app_backend app:10000;
        proxy_pass http://$app_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 90s;
        proxy_connect_timeout 5s;
    }
}
