{
  "name": "agentpay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write web/src vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check web/src vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.2.8",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
